% Default values when options are not specified
\usepackage{xspace}
\newcommand{\project}{\textsf{ProjectName}\xspace}
\newcommand{\note}[1]{}
\newcommand{\todo}[2]{}

% Which DN variant this proposal is evaluated as: DN (standard, the
% default), DN-ID (industrial doctorate) or DN-JD (joint doctorate).
% Shown in the page header and on the start/end pages (\mscpage), and
% also controls (via \mscinputifdnjd below) whether the DN-JD-only
% Letters of pre-agreement section is pulled in. Override in common.tex
% for the specific proposal, e.g. \renewcommand{\dnvariant}{DN-JD}
\newcommand{\dnvariant}{DN}

% Whether this proposal also opts in to the RAISE pilot call
% (HORIZON-RAISE-2026-01-MSCA); controls whether that line is shown on
% the start/end pages (\mscpage), and (via \mscinputifraise below)
% whether the RAISE DN section is pulled in. Defaults to false (a
% typical DN does not opt in); set \raiseoptedtrue in common.tex for a
% proposal that does.
\newif\ifraiseopted
\raiseoptedfalse

% \mscinputifdnjd{<file>} pulls in <file> only when \dnvariant is
% DN-JD -- use it in place of \input{letters} in master.tex/PartB2.tex,
% so the Letters of pre-agreement section follows \dnvariant
% automatically instead of needing its own \input line kept in sync by
% hand (in both files) every time \dnvariant changes. The comparison is
% a plain-TeX \ifx test against the (parameterless, non-\xspace'd)
% \dnvariant text, so it needs no extra package.
\newcommand{\mscinputifdnjd}[1]{%
    \def\msc@dnjd{DN-JD}%
    \ifx\dnvariant\msc@dnjd
        \input{#1}%
    \fi
}

% Same idea as \mscinputifdnjd, but gated on \ifraiseopted -- use it in
% place of \input{raise} in master.tex/PartB2.tex.
\newcommand{\mscinputifraise}[1]{%
    \ifraiseopted
        \input{#1}%
    \fi
}

% Options.  Unknown options assumed to be project name
\newcommand*{\getproject}[1]{%
    \renewcommand{\project}{\textsf{#1}\xspace}%
}
\DeclareOption*{\expandafter\getproject\expandafter{\CurrentOption}}
\DeclareOption{draft}{
    \renewcommand{\note}[1]{{\color{blue}\textit{#1}}}
    \renewcommand{\todo}[2]{\par
        {\color{red}{\textbf{[#1] #2}}}%
        \addcontentsline{toc}{subsubsection}{{\color{red}{[#1] #2}}}
    }
}
\ProcessOptions\relax

% Minimum font size should be 11pt in the document header.  This yields
%  \normalsize   10.95 pt, the minimum size for both body text and tables as of 2026
%  \footnotesize 9 pt
%  \scriptsize   8 pt, suitable for footnote references
\usepackage[a4paper,margin=15mm]{geometry}
\usepackage[bf,small]{titlesec}
% Halve the default vertical space above \paragraph headings (article.cls
% default is 3.25ex plus 1ex minus 0.2ex before, -1em after for the
% run-in style); \paragraph is used heavily for WP tasks, DC objectives
% and DC profiles (\mscwptask, mscobj, mscdc), so this adds up over the
% document.
\titlespacing*{\paragraph}{0pt}{1.625ex plus 0.5ex minus 0.1ex}{1em}
% titlesec silently turns \subsubsection's compact kernel run-in spacing
% (article.cls default: 3.25ex plus 1ex minus 0.2ex before, -1em after)
% into a much more spaced-out block heading once loaded with any options
% (as it is above) -- restore a small/negative afterskip so body text
% and tables sit close under every \subsubsection, not just \msccaption's.
\titlespacing*{\subsubsection}{0pt}{2.25ex plus 1ex minus 0.2ex}{0.3em}
