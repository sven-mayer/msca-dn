% TOC needs to fit on one page with in-y'r-face title
\renewcommand{\contentsname}{TABLE OF CONTENTS}
\setcounter{tocdepth}{3}

% Shrink the extra vertical gap article.cls inserts above each \section
% entry in the TOC (default 1.0em plus 1pt) so the TOC takes less space.
\makeatletter
\renewcommand*\l@section[2]{%
  \ifnum \c@tocdepth >\z@
    \addpenalty\@secpenalty
    \addvspace{0.4em \@plus\p@}%
    \setlength\@tempdima{1.5em}%
    \begingroup
      \parindent \z@ \rightskip \@pnumwidth
      \parfillskip -\@pnumwidth
      \leavevmode \bfseries
      \advance\leftskip\@tempdima
      \hskip -\leftskip
      #1\nobreak\hfil \nobreak\hb@xt@\@pnumwidth{\hss #2}\par
    \endgroup
  \fi}
\makeatother

% The \checkmark is in here
\usepackage{amssymb}

% For tables; these are not floats, they are more just tabular environments.  With [11pt] in the documentstyle, \scriptsize is 8pt
\usepackage{array}
\usepackage{longtable}
\usepackage[table]{xcolor}
\providecommand{\ra}{\raggedright\arraybackslash} % for use in table column specs, e.g. >{\ra}p{30mm}
\newenvironment{msctable}[2][\normalsize]{% \normalsize is 10.95pt, the minimum table size as of 2026
  \begin{center}
    #1 % Set the right size (and font maybe)
    \begin{tabular}{#2}
}{%
    \end{tabular}
  \end{center}
}

% Same as msctable, but backed by longtable so the table is allowed to
% break across a page boundary, repeating the header row(s) on each new
% page.  Use this instead of msctable for anything that may run longer
% than one page once filled in -- e.g. a work package description or a
% participating-organisation profile.  Put \endfirsthead/\endhead right
% after the header row(s) that should repeat on every continuation page.
%
% \newenvironment itself adds no grouping (unlike msctable above, which
% gets one for free from \begin{center}...\end{center}), so #1 is
% explicitly scoped with \begingroup/\endgroup here.  Without that, any
% size override passed as #1 would leak into every file after this one:
% \include and \input both lack a group of their own, so a bare
% \footnotesize (or any other declaration) set here would silently apply
% to the rest of the document from this point on.
% The 2026 call template requires a minimum of 11pt in tables (not just
% body text), so #1 must be left empty here -- that way the table just
% inherits the ambient \normalsize. Do not pass \footnotesize (or
% anything smaller) as #1; the \begingroup/\endgroup below is a safety
% net against that mistake leaking out, not a license to make it.
\newenvironment{msctablelong}[2][]{%
    \begingroup
    #1 % Leave empty -- see above; tables must stay at \normalsize (11pt minimum)
    \begin{longtable}{#2}
}{%
    \end{longtable}
    \endgroup
}

% Tags used by EU MSCA action system
\newcommand{\size}[2]{{\fontsize{#1}{0}\selectfont#2}}
\newcommand{\DNtag}[1]{\textcolor{gray}{\size{9}{\#@#1@\#}}}
\newcommand{\DNtage}[1]{\textcolor{gray}{\size{9}{\#§#1§\#}}}

% Using a section command here prevents the widow / orphan thing with
% homemade command.
%
% Many tables/blocks here have a fixed identifier mandated by the call
% template (e.g. "Table 3.1a") that's referenced by name elsewhere in
% the document. \msccaption takes 3 args so those can be labelled and
% cross-referenced via \autoref, the same way \mscwp/mscobj/mscdc below
% are:
%   #1 = full caption text as printed, e.g. "Table 3.1a: Description of Work Packages"
%   #2 = short identifier to show via \autoref (e.g. "Table 3.1a"); leave empty ({}) to skip labelling
%   #3 = label key (e.g. tab:wp-description); ignored when #2 is empty
% Unlike \mscwp/mscobj/mscdc's counters, #2 is not auto-numbered -- it's
% a fixed string (the call template already dictates the exact
% numbering), so \themsctab is simply redefined to that string each
% time, and \msctabautorefname swallows hyperref's tie and prints
% nothing, since \themsctab already contains the full "Table 3.1a"-style
% text.
\makeatletter
\newcounter{msctab}
\newcommand*{\msctabautorefname}[1]{}
\newcommand{\msccaption}[3]{%
    \subsubsection*{#1}%
    \def\msccaption@id{#2}%
    \ifx\msccaption@id\@empty\else
        \renewcommand{\themsctab}{#2}%
        \refstepcounter{msctab}%
        \label{#3}%
    \fi
}
\makeatother

% Same fixed-identifier labelling trick as \msccaption, but for a single
% row identifier/code inside a list-style table -- a deliverable (e.g.
% "SD2.1") or a milestone (e.g. "MS10") -- so other prose can
% cross-reference the exact row that defines it instead of repeating a
% bare code that may drift out of sync with the table. Usage:
% \mscdeliv{SD2.1}{deliv:sd2-1} in place of the literal "SD2.1 &" cell
% text -- it still prints the code, just also labels it.
\makeatletter
\newcounter{mscdeliv}
\newcommand*{\mscdelivautorefname}[1]{}
\newcommand{\mscdeliv}[2]{%
    \renewcommand{\themscdeliv}{#1}%
    \refstepcounter{mscdeliv}%
    \label{#2}%
    #1%
}
\makeatother

% Low level sectioning.  Could be \paragraph if space is short
\newcommand{\mscsection}[1]{\subsubsection*{#1}}

% Tables have coloured headings.  This ensures some consistency
\colorlet{msccolor}{olive!20}
\newcommand{\colorrow}{\rowcolor{msccolor}}
\newcommand{\colorcell}{\cellcolor{msccolor}}

% Work package tables need to look the same, and match the official
% call template's layout exactly: Table 3.1a (Tpl_Application Form
% (Part B) (HE MSCA DN).rtf) is a single header row with WP Number, WP
% title and Start-End month side by side, followed by a "Lead
% participant" row below it -- not three stacked label/value rows.
% Backed by msctablelong (longtable) rather than msctable (plain
% tabular) so a WP block that runs long -- several \mscwptask rows plus
% Description of Deliverables -- can break across a page boundary
% instead of needing to fit on one page.  \endhead repeats a short
% "Continued" row at the top of each continuation page.
%
% 3rd argument is a \label key (e.g. wp:management) so the WP can be
% cross-referenced elsewhere via \autoref{wp:management} -- clickable,
% and showing "WP1" (etc.) since \refstepcounter{wp} runs first. The
% Lead participant row is not a \mscwp argument -- call
% \mscwpparsplit{Lead participant}{...} as the first line of the WP's
% body, the same way Participants/DCs involved are called, since it's
% just another label|value row below the header, not special to the
% environment.
%
% The closing \hline below the body is automatic -- the body's last row
% should end in \\ only. Adding your own trailing \hline there draws a
% doubled bottom border.
\newcounter{wp}
\newcounter{task}[wp]
% Swallow the tie hyperref's \autoref always appends after expanding
% "\wpautorefname", giving "WP1" instead of "WP 1" with no need to patch
% hyperref itself.
\newcommand*{\wpautorefname}[1]{WP}
\newenvironment{mscwp}[3]{%
    \refstepcounter{wp}
    \label{#3}%
    \begin{msctablelong}{|>{\ra}p{30mm}|>{\ra}p{107mm}|>{\ra}p{30mm}|}
        \hline
        % Per the RTF, only column 1 is shaded here (and in the
        % Lead participant/Participants/DCs involved rows in the body)
        % -- \colorcell, not \colorrow. Objectives and Description of
        % Work have no shading at all.
        \colorcell\textbf{WP\arabic{wp}} & #2 & #1 \\
        \hline
        \endfirsthead
        \hline
        % \rowcolor is unreliable in longtable (colortbl's row-shading
        % doesn't understand longtable's internals, and ends up shading
        % the wrong row); \cellcolor placed inside the cell works
        % correctly, so that's used here instead of \colorrow.
        \multicolumn{3}{|p{167mm}|}{\colorcell\textit{Continued --- WP\arabic{wp}: #2}} \\
        \hline
        \endhead
}{
        \hline
    \end{msctablelong}
}
% A label cell (column 1) plus its value spanning the remaining two
% columns -- used for the "Lead participant"/"Participants"/"DCs
% involved" rows, which sit below the WP Number/title/dates header row
% rather than being their own column. Per the RTF, only the label cell
% (column 1) is shaded -- the value cell has no background colour.
\newcommand{\mscwpparsplit}[2]{\colorcell\textbf{#1} & \multicolumn{2}{p{137mm}|}{#2}\\
    \hline}
\newcommand{\mscwppar}[2]{\multicolumn{3}{|p{167mm}|}{%
    \textbf{#1:} #2}}
\newcommand{\mscwptask}[2]{%
    \mscwppar{\textit{\refstepcounter{task}Task \arabic{wp}.\arabic{task}. #1}}{#2}}

% Similar for research projects
\newenvironment{mscrp}{%
    \begin{msctable}{|c|c|c|c|c|c|}
        \hline
        \colorrow
        \textbf{Fellow} &
        \textbf{Host institution} &
        \textbf{PhD enrolment} &
        \textbf{Start date} &
        \textbf{Duration} &
        \textbf{Deliverables} \\
        \hline
}{
        \hline
    \end{msctable}
}
\newcommand{\mscrppar}[2]{\multicolumn{6}{|p{175mm}|}{%
    \textbf{#1:} #2}}

% Per-organisation profile tables (Participating Organisations section).
% Backed by msctablelong (longtable) like mscwp, since a filled-in
% beneficiary/associated-partner profile commonly runs past the "one
% page" the call template asks for.  #1 is the header text, e.g.
% "Beneficiary Legal Name: Name of organisation"; it repeats on every
% continuation page via \endhead.
%
% The closing \hline below the body is automatic -- the body's last row
% should end in \\ only. Adding your own trailing \hline there draws a
% doubled bottom border.
% \rowcolor is unreliable in longtable (colortbl's row-shading doesn't
% understand longtable's internals, and ends up shading the wrong row);
% \cellcolor placed inside the cell works correctly, so that's used
% below instead of \colorrow.
\newenvironment{mscorg}[1]{%
    \begin{msctablelong}{|>{\ra}p{45mm}|>{\ra}p{125mm}|}
        \hline
        \multicolumn{2}{|l|}{\colorcell\textbf{#1}} \\
        \hline
        \endfirsthead
        \hline
        \multicolumn{2}{|l|}{\colorcell\textit{Continued --- #1}} \\
        \hline
        \endhead
}{
        \hline
    \end{msctablelong}
}

% Doctoral Network Objectives (O1-O4) need the same cross-referencing
% mechanism as the WPs: an auto-numbered "O<n>: <title>" paragraph
% heading with a label, so they can be cited elsewhere via
% \autoref{obj:...} -- clickable, and showing "O1" (etc.) since
% \refstepcounter{obj} runs first.
\newcounter{obj}
% Same trick as \wpautorefname: swallow the tie hyperref always appends.
\newcommand*{\objautorefname}[1]{O}
\newenvironment{mscobj}[2]{%
    \refstepcounter{obj}
    \label{#2}%
    \paragraph{O\arabic{obj}: #1}%
}{}

% Doctoral Candidate (DC) profile paragraphs need the same mechanism: an
% auto-numbered "DC<n>: <title> (<meta>)" paragraph heading with a
% label, so they can be cited elsewhere via \autoref{dc:...} --
% clickable, and showing "DC1" (etc.) since \refstepcounter{dc} runs
% first.
\newcounter{dc}
% Same trick as \wpautorefname/\objautorefname: swallow hyperref's tie.
\newcommand*{\dcautorefname}[1]{DC}
\newenvironment{mscdc}[3]{%
    \refstepcounter{dc}
    \label{#3}%
    \paragraph{DC\arabic{dc}: #1 (#2)}%
}{}

